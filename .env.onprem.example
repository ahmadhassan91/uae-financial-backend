# =============================================================================
# ON-PREM DEPLOYMENT CONFIGURATION (.env for National Bonds server)
# =============================================================================
# Copy this file to .env on the on-prem server at:
# /home/finclinic01/projects/uae-financial-backend/.env
# =============================================================================

# Database Configuration (PostgreSQL on local server)
DATABASE_URL=postgresql://finclinic01:YOUR_DB_PASSWORD@localhost:5432/financial_clinic
DATABASE_URL_TEST=postgresql://finclinic01:YOUR_DB_PASSWORD@localhost:5432/financial_clinic_test

# Security (CHANGE THIS TO A SECURE RANDOM KEY!)
SECRET_KEY=GENERATE_A_NEW_SECURE_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment - MUST be 'production' for on-prem
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# EMAIL CONFIGURATION (National Bonds Internal SMTP Relay)
# =============================================================================
# Using internal relay - no authentication needed (IP whitelisted)
SMTP_HOST=smtprelay.nationalbonds.ae
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=financialclinic@nationalbonds.ae
FROM_NAME=National Bonds Financial Clinic

# =============================================================================
# STORAGE CONFIGURATION (NFS for on-prem, NOT S3)
# =============================================================================
# Disable S3, enable NFS
USE_S3_STORAGE=false
USE_NFS_STORAGE=true

# NFS mount point (must be mounted on the server)
# Mount command: sudo mount -t nfs 192.168.125.35:/financialclinic /mnt/financialclinic
NFS_MOUNT_PATH=/mnt/financialclinic
NFS_REPORTS_SUBDIR=reports
NFS_ICONS_SUBDIR=icons

# Public URL for accessing NFS files via nginx proxy
NFS_PUBLIC_URL_BASE=https://financialclinic.ae/storage

# AWS S3 - Leave empty for on-prem (not used)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# =============================================================================
# URL CONFIGURATION (Using financialclinic.ae domain)
# =============================================================================
# Backend URLs - API accessed via nginx reverse proxy
BACKEND_BASE_URL=https://financialclinic.ae/api
PRODUCTION_BACKEND_URL=https://financialclinic.ae/api

# Frontend URLs - Same domain, different paths
FRONTEND_BASE_URL=https://financialclinic.ae
PRODUCTION_BASE_URL=https://financialclinic.ae

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allow requests from the financialclinic.ae domain
CORS_ORIGINS=https://financialclinic.ae,https://www.financialclinic.ae

# Allowed hosts for the backend
ALLOWED_HOSTS=financialclinic.ae,www.financialclinic.ae,192.168.128.135,localhost

# =============================================================================
# REDIS (Optional - for caching/sessions)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# FILE UPLOADS
# =============================================================================
UPLOAD_DIR=./uploads
DOWNLOAD_DIR=./downloads
MAX_FILE_SIZE=10485760
