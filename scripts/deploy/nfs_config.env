# NFS Storage Configuration for On-Prem Deployment
USE_NFS_STORAGE=True
NFS_MOUNT_PATH=/mnt/financialclinic
NFS_REPORTS_SUBDIR=reports
NFS_ICONS_SUBDIR=icons
NFS_PUBLIC_URL_BASE=https://financialclinic.ae/storage

# Disable S3 Storage
USE_S3_STORAGE=False

# Other required settings
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
